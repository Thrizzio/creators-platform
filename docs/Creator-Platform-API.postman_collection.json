      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Register response includes created user data', function () {",
                  "  pm.expect(response.success).to.eql(true);",
                  "  pm.expect(response.message).to.be.a('string');",
                  "  pm.expect(response.data).to.be.an('object');",
                  "  pm.expect(response.data).to.have.property('id');",
                  "  pm.expect(response.data).to.have.property('name');",
                  "  pm.expect(response.data).to.have.property('email');",
                  "});"
